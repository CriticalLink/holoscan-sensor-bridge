set_instance_assignment -name IO_STANDARD DPHY  -to LINK3_dphy_io_dphy_link_d_n[1]  -entity mitysom_25g_hps_8cam

#-- data lane 2 (CSI4_RX2, DIFF_IO_2B_T21)
set_location_assignment PIN_BP41                -to LINK3_dphy_io_dphy_link_d_p[2]
set_location_assignment PIN_BM41                -to LINK3_dphy_io_dphy_link_d_n[2]
set_instance_assignment -name IO_STANDARD DPHY  -to LINK3_dphy_io_dphy_link_d_p[2]  -entity mitysom_25g_hps_8cam
