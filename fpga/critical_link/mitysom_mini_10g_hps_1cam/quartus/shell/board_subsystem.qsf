#=================================================================================
# set global assignments

# from GSRD / golden_top.qsf
set_global_assignment -name DEVICE_INITIALIZATION_CLOCK OSC_CLK_1_25MHZ
set_global_assignment -name ENABLE_INTERMEDIATE_SNAPSHOTS ON

# Power management follows the part: a group A part (A5ED008A..., A5ED013A..., A5ED043A...) needs
# SmartVID, a TDK FS1525 regulator over the SDM PMBus master; a group B part runs at a fixed voltage.
set device [get_global_assignment -name DEVICE]
set_global_assignment -name PWRMGT_VOLTAGE_OUTPUT_FORMAT "LINEAR FORMAT"
if {[regexp {^A5ED(008|013|043)A} $device]} {
    set_global_assignment -name PWRMGT_LINEAR_FORMAT_N "-10"
    set_global_assignment -name USE_PWRMGT_SCL SDM_IO14
    set_global_assignment -name USE_PWRMGT_SDA SDM_IO11
    set_global_assignment -name USE_PWRMGT_ALERT SDM_IO12
    set_global_assignment -name PWRMGT_SLAVE_DEVICE_TYPE OTHER
    set_global_assignment -name PWRMGT_SLAVE_DEVICE0_ADDRESS 75
    set_global_assignment -name ENABLE_STATUS_BYTE OFF
} elseif {[regexp {^A5ED(008|013|043)B} $device]} {
    set_global_assignment -name PWRMGT_LINEAR_FORMAT_N "-12"
} else {
    error "board_subsystem.qsf: DEVICE '$device' is not an A5ED008, A5ED013 or A5ED043 part, or is\
           set after this file"
}
set_global_assignment -name BOARD default

set_global_assignment -name STRATIX_JTAG_USER_CODE 4
set_global_assignment -name USE_CHECKSUM_AS_USERCODE OFF

#=================================================================================
# set pin assignments

# clock/global reset
# The fabric IOPLL takes the 133.33 MHz HPS_CLKIN_P (A26, in hps.qsf) from the HPS EMIF's shared
# refclk output: the EMIF's refclk input buffer must own the pin.

# Mini baseboard push button S4 (DEBUG1)
set_location_assignment PIN_R10      -to rst_pb_n
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to rst_pb_n -entity mitysom_mini_10g_hps_1cam

# MitySOM-A5E Mini baseboard debug LEDs 1 and 2 (HVIO bank 6D, 3.3V, active-high)
#   dbg_led_1 = GTS system PLL locked; dbg_led_2 = RX CDR lock
set_location_assignment PIN_U14 -to dbg_led_1
set_location_assignment PIN_R14 -to dbg_led_2
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to dbg_led_1 -entity mitysom_mini_10g_hps_1cam
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to dbg_led_2 -entity mitysom_mini_10g_hps_1cam

set_global_assignment -name IP_FILE ../rtl/shell/ip/board_subsystem/board_subsystem_board_pb_reset_generator.ip
set_global_assignment -name IP_FILE ../rtl/shell/ip/board_subsystem/board_subsystem_board_init_generator.ip
set_global_assignment -name IP_FILE ../rtl/shell/ip/board_subsystem/board_subsystem_board_reset_controller.ip
set_global_assignment -name IP_FILE ../rtl/shell/ip/board_subsystem/board_subsystem_board_init_reset_bridge.ip
set_global_assignment -name IP_FILE ../rtl/shell/ip/board_subsystem/board_subsystem_board_clk_bridge.ip
set_global_assignment -name QSYS_FILE ../rtl/shell/board_subsystem.qsys
