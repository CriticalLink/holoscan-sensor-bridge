#-- data lane 3 (CSI4_RX3, DIFF_IO_2B_T20)
set_location_assignment PIN_BH38                -to LINK3_dphy_io_dphy_link_d_p[3]
set_location_assignment PIN_BH41                -to LINK3_dphy_io_dphy_link_d_n[3]
set_instance_assignment -name IO_STANDARD DPHY  -to LINK3_dphy_io_dphy_link_d_p[3]  -entity mitysom_25g_hps_8cam
