###################################################################################
# HPS pin assignments for mitysom_10g_hps_8cam
#
# Pin assignments from the MitySOM-A5E reference design. The HPS LPDDR4 (x32)
# lives on bank 3A alongside the 5th MIPI camera (LINK4/J20 D-PHY) on disjoint
# pins. Bank 3A is set to 1.1V for both the LVSTL DDR and the D-PHY.
###################################################################################

# Shared DDR/D-PHY bank voltage
set_global_assignment -name IOBANK_VCCIO 1.1V -section_id 3A_B
set_global_assignment -name IOBANK_VCCIO 1.1V -section_id 3A_T

set_location_assignment PIN_AK107 -to HPS_CK_T -comment IOBANK_3A_B
set_instance_assignment -name IO_STANDARD "DIFFERENTIAL 1.1-V LVSTL" -to HPS_CK_T
set_location_assignment PIN_AK104 -to HPS_CK_C -comment IOBANK_3A_B
set_instance_assignment -name IO_STANDARD "DIFFERENTIAL 1.1-V LVSTL" -to HPS_CK_C
set_location_assignment PIN_V108 -to HPS_CKE[0] -comment IOBANK_3A_B
set_instance_assignment -name IO_STANDARD "1.1-V LVSTL" -to HPS_CKE[0]
set_location_assignment PIN_T108 -to HPS_CKE[1] -comment IOBANK_3A_B
set_instance_assignment -name IO_STANDARD "1.1-V LVSTL" -to HPS_CKE[1]
set_location_assignment PIN_AG111 -to HPS_MEM_RESET_N -comment IOBANK_3A_B
