# MitySOM-A5E STD: R12 on the baseboard pulls SFP TX_DISABLE low; the FPGA does not drive it


# Transceivers
# MitySOM-A5E STD: GTS L1C CH1 refclk = AP120 (REFCLK_GTSL1C_CH1_P), feeds the SFP serial lanes
  set_location_assignment PIN_AP120 -to refclk_eth

set_location_assignment PIN_AK135 -to serial_i_rx_serial_data
set_location_assignment PIN_AK133 -to serial_i_rx_serial_data_n
set_location_assignment PIN_AL129 -to serial_o_tx_serial_data
set_location_assignment PIN_AL126 -to serial_o_tx_serial_data_n

set_instance_assignment -name IO_STANDARD HCSL                          -to refclk_eth                -entity mitysom_25g_hps_8cam

set_instance_assignment -name IO_STANDARD "HIGH SPEED DIFFERENTIAL I/O" -to serial_i_rx_serial_data   -entity mitysom_25g_hps_8cam
set_instance_assignment -name IO_STANDARD "HIGH SPEED DIFFERENTIAL I/O" -to serial_i_rx_serial_data_n -entity mitysom_25g_hps_8cam
set_instance_assignment -name IO_STANDARD "HIGH SPEED DIFFERENTIAL I/O" -to serial_o_tx_serial_data   -entity mitysom_25g_hps_8cam
set_instance_assignment -name IO_STANDARD "HIGH SPEED DIFFERENTIAL I/O" -to serial_o_tx_serial_data_n -entity mitysom_25g_hps_8cam


