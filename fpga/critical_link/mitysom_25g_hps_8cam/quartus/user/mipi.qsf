#=== Camera enable / control IOs (HVIO Bank 5B, 3.3V) ===========================
#-- Driven HIGH in the top-level RTL to power on / enable the cameras so I2C works.
set_location_assignment PIN_BF111               -to cam1_io1
set_location_assignment PIN_BH109               -to cam1_io2
set_location_assignment PIN_BE115               -to cam2_io1
set_location_assignment PIN_BF115               -to cam2_io2
