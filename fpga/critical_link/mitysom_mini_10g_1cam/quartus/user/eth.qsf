# MitySOM-A5E Mini baseboard: SFP TX_DISABLE on BM80 (HVIO bank 5A), driven low by the FPGA
set_location_assignment PIN_BM80 -to sfp_tx_dis
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to sfp_tx_dis -entity mitysom_mini_10g_1cam


# Transceivers
# MitySOM-A5E Mini baseboard: GTS regional refclk = AU69 (156.25 MHz from U10 CLK1), feeds the SFP
# serial lanes on GTS channel 3 (bank 1A on the A5ED013, 1C on the A5ED043)
  set_location_assignment PIN_AU69 -to refclk_eth

set_location_assignment PIN_P81 -to serial_i_rx_serial_data
set_location_assignment PIN_P79 -to serial_i_rx_serial_data_n
set_location_assignment PIN_V75 -to serial_o_tx_serial_data
set_location_assignment PIN_V72 -to serial_o_tx_serial_data_n

set_instance_assignment -name IO_STANDARD HCSL                          -to refclk_eth                -entity mitysom_mini_10g_1cam

set_instance_assignment -name IO_STANDARD "HIGH SPEED DIFFERENTIAL I/O" -to serial_i_rx_serial_data   -entity mitysom_mini_10g_1cam
set_instance_assignment -name IO_STANDARD "HIGH SPEED DIFFERENTIAL I/O" -to serial_i_rx_serial_data_n -entity mitysom_mini_10g_1cam
set_instance_assignment -name IO_STANDARD "HIGH SPEED DIFFERENTIAL I/O" -to serial_o_tx_serial_data   -entity mitysom_mini_10g_1cam
set_instance_assignment -name IO_STANDARD "HIGH SPEED DIFFERENTIAL I/O" -to serial_o_tx_serial_data_n -entity mitysom_mini_10g_1cam


