#=== LINK2 = CSI3 (J17) =========================================================
#-- clock lane (CSI3_RXCLK, DIFF_IO_2B_T16)
set_location_assignment PIN_BE61                -to LINK2_dphy_io_dphy_link_c_p
set_location_assignment PIN_BE57                -to LINK2_dphy_io_dphy_link_c_n
set_instance_assignment -name IO_STANDARD DPHY  -to LINK2_dphy_io_dphy_link_c_p     -entity mitysom_25g_hps_8cam
