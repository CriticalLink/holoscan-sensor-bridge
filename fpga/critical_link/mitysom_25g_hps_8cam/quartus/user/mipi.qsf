set_location_assignment PIN_AG93                -to LINK4_dphy_io_dphy_link_c_n
set_instance_assignment -name IO_STANDARD DPHY  -to LINK4_dphy_io_dphy_link_c_p     -entity mitysom_25g_hps_8cam
