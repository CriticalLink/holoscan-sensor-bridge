###################################################################################
# HPS pin assignments for mitysom_mini_10g_hps_1cam
#
# Pin assignments from the MitySOM-A5E reference design for the Mini SOM on the
# Mini baseboard. The HPS LPDDR4 (x32) lives on bank 3A alongside the camera
# D-PHY link (LINK0/J7) on disjoint pins. Bank 3A is set to 1.1V for both the
# LVSTL DDR and the D-PHY.
###################################################################################

# Shared DDR/D-PHY bank voltage
set_global_assignment -name IOBANK_VCCIO 1.1V -section_id 3A_B
set_global_assignment -name IOBANK_VCCIO 1.1V -section_id 3A_T

set_location_assignment PIN_K31 -to HPS_CK_T -comment IOBANK_3A_B
set_instance_assignment -name IO_STANDARD "DIFFERENTIAL 1.1-V LVSTL" -to HPS_CK_T
set_location_assignment PIN_K28 -to HPS_CK_C -comment IOBANK_3A_B
set_instance_assignment -name IO_STANDARD "DIFFERENTIAL 1.1-V LVSTL" -to HPS_CK_C
set_location_assignment PIN_B34 -to HPS_CKE[0] -comment IOBANK_3A_B
set_instance_assignment -name IO_STANDARD "1.1-V LVSTL" -to HPS_CKE[0]
set_location_assignment PIN_A34 -to HPS_CKE[1] -comment IOBANK_3A_B
set_instance_assignment -name IO_STANDARD "1.1-V LVSTL" -to HPS_CKE[1]
set_location_assignment PIN_K36 -to HPS_MEM_RESET_N -comment IOBANK_3A_B
set_instance_assignment -name IO_STANDARD "1.1-V LVSTL" -to HPS_MEM_RESET_N
set_location_assignment PIN_B32 -to HPS_CS[0] -comment IOBANK_3A_B
set_instance_assignment -name IO_STANDARD "1.1-V LVSTL" -to HPS_CS[0]
set_location_assignment PIN_A29 -to HPS_CS[1] -comment IOBANK_3A_B
set_instance_assignment -name IO_STANDARD "1.1-V LVSTL" -to HPS_CS[1]
