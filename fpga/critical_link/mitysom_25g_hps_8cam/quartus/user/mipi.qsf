#-- data lane 1 (CSI3_RX1, DIFF_IO_2B_T17)
set_location_assignment PIN_BE64                -to LINK2_dphy_io_dphy_link_d_p[1]
set_location_assignment PIN_BF64                -to LINK2_dphy_io_dphy_link_d_n[1]
