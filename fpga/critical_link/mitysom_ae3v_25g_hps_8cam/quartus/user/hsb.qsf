set_global_assignment -name VERILOG_MACRO "PSG=1"
# The host receives over the Linux network stack, so the CoE (IEEE 1722B) packet path is unused
set_global_assignment -name VERILOG_MACRO "DISABLE_COE"

# MitySOM-A5E STD -6/-7 baseboard: only i2c_0 is used. It drives I2C_EMAC0_SCL/SDA_OVRRIDE_1V3
# (bank 2A, 1.3 V), which the LSF0102 level shifter U73 passes onto I2C_EMAC0, the bus of the
# PCA9548A camera mux. U73 is enabled only with switch S7 on its +1.8V side.
set_location_assignment PIN_CK76 -to i2c_0_scl
set_location_assignment PIN_CL76 -to i2c_0_sda

set_instance_assignment -name IO_STANDARD "1.3-V LVCMOS" -to i2c_0_scl
set_instance_assignment -name IO_STANDARD "1.3-V LVCMOS" -to i2c_0_sda

set_instance_assignment -name AUTO_OPEN_DRAIN_PINS ON -to i2c_0_scl -entity mitysom_ae3v_25g_hps_8cam
set_instance_assignment -name AUTO_OPEN_DRAIN_PINS ON -to i2c_0_sda -entity mitysom_ae3v_25g_hps_8cam

set_instance_assignment -name TERMINATION "OFF" -to i2c_0_scl -entity mitysom_ae3v_25g_hps_8cam
set_instance_assignment -name TERMINATION "OFF" -to i2c_0_sda -entity mitysom_ae3v_25g_hps_8cam

# i2c_1 (HSB IP's 2nd I2C master) is unused on MitySOM-A5E STD; no pin assignment needed.


