#-- MitySOM-A5E STD baseboard MIPI pinout (HVIO Banks 2B and 3A)
#--   LINK0 = CSI1 -> camera connector J16 (Bank 2B)
#--   LINK1 = CSI2 -> camera connector J15 (Bank 2B)
#--   LINK2 = CSI3 -> camera connector J17 (Bank 2B)
#--   LINK3 = CSI4 -> camera connector J18 (Bank 2B)
#--   LINK4 = CSI5 -> camera connector J20 (Bank 3A, second D-PHY instance)
#--   LINK5 = CSI6 -> camera connector J24 (Bank 2B)
#--   LINK6 = CSI7 -> camera connector J25 (Bank 2B)
#--   LINK7 = CSI8 -> camera connector J26 (Bank 2B)

#-- MIPI reference clock (MIPI_REFCLK0, PLL U68) on CLK_B_2B_1p
set_location_assignment PIN_BR49                                              -to mipi_ref_clk_0  -comment CLK_B_2B_1p
set_instance_assignment -name IO_STANDARD "1.1V TRUE DIFFERENTIAL SIGNALING"  -to mipi_ref_clk_0  -entity mitysom_25g_hps_8cam

#-- Bank 2B RZQ (byte-loc 7 sub-bank, paired with the BR49 refclk)
set_location_assignment PIN_BR52                  -to mipi_rzq
set_instance_assignment -name IO_STANDARD "1.1 V" -to mipi_rzq  -entity mitysom_25g_hps_8cam

#-- MIPI reference clock (MIPI_REFCLK1, PLL U68) on CLK_T_3A_1p, for the Bank 3A D-PHY
set_location_assignment PIN_V98                                               -to mipi_ref_clk_1  -comment CLK_T_3A_1p
set_instance_assignment -name IO_STANDARD "1.1V TRUE DIFFERENTIAL SIGNALING"  -to mipi_ref_clk_1  -entity mitysom_25g_hps_8cam

#-- Bank 3A RZQ (RZQ_T_3A, GUI_RZQ_ID=1 in the second D-PHY)
set_location_assignment PIN_P95                   -to mipi_rzq_1
set_instance_assignment -name IO_STANDARD "1.1 V" -to mipi_rzq_1  -entity mitysom_25g_hps_8cam

#=== LINK0 = CSI1 (J16) =========================================================
#-- clock lane (CSI1_RXCLK, DIFF_IO_2B_T4)
set_location_assignment PIN_CF28                -to LINK0_dphy_io_dphy_link_c_p
set_location_assignment PIN_CC28                -to LINK0_dphy_io_dphy_link_c_n
set_instance_assignment -name IO_STANDARD DPHY  -to LINK0_dphy_io_dphy_link_c_p     -entity mitysom_25g_hps_8cam
set_instance_assignment -name IO_STANDARD DPHY  -to LINK0_dphy_io_dphy_link_c_n     -entity mitysom_25g_hps_8cam

#-- data lane 0 (CSI1_RX0, DIFF_IO_2B_T6)
set_location_assignment PIN_CH31                -to LINK0_dphy_io_dphy_link_d_p[0]
set_location_assignment PIN_CF31                -to LINK0_dphy_io_dphy_link_d_n[0]
set_instance_assignment -name IO_STANDARD DPHY  -to LINK0_dphy_io_dphy_link_d_p[0]  -entity mitysom_25g_hps_8cam
set_instance_assignment -name IO_STANDARD DPHY  -to LINK0_dphy_io_dphy_link_d_n[0]  -entity mitysom_25g_hps_8cam

#-- data lane 1 (CSI1_RX1, DIFF_IO_2B_T5)
set_location_assignment PIN_CA31                -to LINK0_dphy_io_dphy_link_d_p[1]
set_location_assignment PIN_CC31                -to LINK0_dphy_io_dphy_link_d_n[1]
set_instance_assignment -name IO_STANDARD DPHY  -to LINK0_dphy_io_dphy_link_d_p[1]  -entity mitysom_25g_hps_8cam
set_instance_assignment -name IO_STANDARD DPHY  -to LINK0_dphy_io_dphy_link_d_n[1]  -entity mitysom_25g_hps_8cam

#-- data lane 2 (CSI1_RX2, DIFF_IO_2B_T3)
set_location_assignment PIN_CC22                -to LINK0_dphy_io_dphy_link_d_p[2]
set_location_assignment PIN_CA22                -to LINK0_dphy_io_dphy_link_d_n[2]
set_instance_assignment -name IO_STANDARD DPHY  -to LINK0_dphy_io_dphy_link_d_p[2]  -entity mitysom_25g_hps_8cam
set_instance_assignment -name IO_STANDARD DPHY  -to LINK0_dphy_io_dphy_link_d_n[2]  -entity mitysom_25g_hps_8cam

#-- data lane 3 (CSI1_RX3, DIFF_IO_2B_T2)
set_location_assignment PIN_CF22                -to LINK0_dphy_io_dphy_link_d_p[3]
set_location_assignment PIN_CH22                -to LINK0_dphy_io_dphy_link_d_n[3]
set_instance_assignment -name IO_STANDARD DPHY  -to LINK0_dphy_io_dphy_link_d_p[3]  -entity mitysom_25g_hps_8cam
set_instance_assignment -name IO_STANDARD DPHY  -to LINK0_dphy_io_dphy_link_d_n[3]  -entity mitysom_25g_hps_8cam

#=== LINK1 = CSI2 (J15) =========================================================
#-- clock lane (CSI2_RXCLK, DIFF_IO_2B_T10)
set_location_assignment PIN_CK17                -to LINK1_dphy_io_dphy_link_c_p
set_location_assignment PIN_CL17                -to LINK1_dphy_io_dphy_link_c_n
set_instance_assignment -name IO_STANDARD DPHY  -to LINK1_dphy_io_dphy_link_c_p     -entity mitysom_25g_hps_8cam
set_instance_assignment -name IO_STANDARD DPHY  -to LINK1_dphy_io_dphy_link_c_n     -entity mitysom_25g_hps_8cam

#-- data lane 0 (CSI2_RX0, DIFF_IO_2B_T12)
set_location_assignment PIN_CL23                -to LINK1_dphy_io_dphy_link_d_p[0]
set_location_assignment PIN_CK26                -to LINK1_dphy_io_dphy_link_d_n[0]
set_instance_assignment -name IO_STANDARD DPHY  -to LINK1_dphy_io_dphy_link_d_p[0]  -entity mitysom_25g_hps_8cam
set_instance_assignment -name IO_STANDARD DPHY  -to LINK1_dphy_io_dphy_link_d_n[0]  -entity mitysom_25g_hps_8cam

#-- data lane 1 (CSI2_RX1, DIFF_IO_2B_T11)
set_location_assignment PIN_CL20                -to LINK1_dphy_io_dphy_link_d_p[1]
set_location_assignment PIN_CK20                -to LINK1_dphy_io_dphy_link_d_n[1]
set_instance_assignment -name IO_STANDARD DPHY  -to LINK1_dphy_io_dphy_link_d_p[1]  -entity mitysom_25g_hps_8cam
set_instance_assignment -name IO_STANDARD DPHY  -to LINK1_dphy_io_dphy_link_d_n[1]  -entity mitysom_25g_hps_8cam

#-- data lane 2 (CSI2_RX2, DIFF_IO_2B_T9)
set_location_assignment PIN_CL14                -to LINK1_dphy_io_dphy_link_d_p[2]
set_location_assignment PIN_CL11                -to LINK1_dphy_io_dphy_link_d_n[2]
set_instance_assignment -name IO_STANDARD DPHY  -to LINK1_dphy_io_dphy_link_d_p[2]  -entity mitysom_25g_hps_8cam
