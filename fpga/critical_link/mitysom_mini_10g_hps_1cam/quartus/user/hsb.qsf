set_global_assignment -name VERILOG_MACRO "PSG=1"

# MitySOM-A5E Mini baseboard: only i2c_0 is used. It is the camera I2C of connector J7, wired
# straight to bank 5A (3.3 V) with no I2C switch: SCL on BF74, SDA on BH74.
set_location_assignment PIN_BF74 -to i2c_0_scl
set_location_assignment PIN_BH74 -to i2c_0_sda

set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to i2c_0_scl
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to i2c_0_sda

set_instance_assignment -name AUTO_OPEN_DRAIN_PINS ON -to i2c_0_scl -entity mitysom_mini_10g_hps_1cam
set_instance_assignment -name AUTO_OPEN_DRAIN_PINS ON -to i2c_0_sda -entity mitysom_mini_10g_hps_1cam

set_instance_assignment -name TERMINATION "OFF" -to i2c_0_scl -entity mitysom_mini_10g_hps_1cam
set_instance_assignment -name TERMINATION "OFF" -to i2c_0_sda -entity mitysom_mini_10g_hps_1cam

# i2c_1 (HSB IP's 2nd I2C master) is unused on the MitySOM-A5E Mini; no pin assignment needed.


