#-- data lane 3 (CSI2_RX3, DIFF_IO_2B_T8)
set_location_assignment PIN_CK11                -to LINK1_dphy_io_dphy_link_d_p[3]
set_location_assignment PIN_CL8                 -to LINK1_dphy_io_dphy_link_d_n[3]
set_instance_assignment -name IO_STANDARD DPHY  -to LINK1_dphy_io_dphy_link_d_p[3]  -entity mitysom_25g_hps_8cam
